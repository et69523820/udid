{
  "functions": {
    "api/test.php": {
      "runtime": "vercel-php@0.7.4"
    }
  },
  "headers": [
    {
      "source": "/(.*\\.mobileconfig)",
      "headers": [
        { "key": "Content-Type", "value": "application/x-apple-aspen-config" }
      ]
    }
  ],
  "routes": [
    { "src": "/(.*\\.mobileconfig)", "dest": "/$1" },
    { "src": "/(.*)", "dest": "/api/test.php" }
  ]
}
